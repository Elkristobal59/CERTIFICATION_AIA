# =============================================================================
# CONFIGURATION PIPELINE FRAUD DETECTION — BLOC 3 (RNCP 41993)
# Copier ce fichier en `.env` (exclu de Git via .gitignore) et renseigner vos accès.
# Architecture Hybride recommandée : Conteneurs Docker locaux (MLflow, Kafka, API, Airflow)
# connectés au Backend Managé Neon PostgreSQL + Bucket AWS S3 + SMTP Gmail.
# =============================================================================

# --- 1. Base de Données Opérationnelle & Backend MLflow (Neon PostgreSQL ou Postgres local) ---
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>.neon.tech/fraud_db?sslmode=require
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>.neon.tech/fraud_mlflow_db?sslmode=require

# --- 2. Serveur MLflow Tracking & Model Registry ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=RealTime_Fraud_Detection_AIA_Bloc3
MLFLOW_MODEL_NAME=fraud_detection_model
MLFLOW_MODEL_ALIAS=champion

# --- 3. Stockage S3 des Artefacts MLflow (AWS S3 réel par défaut ; MinIO si endpoint renseigné) ---
# Pour MinIO local 100 % offline, décommenter : MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=<VOTRE_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<VOTRE_AWS_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=eu-west-3
MLFLOW_ARTIFACT_BUCKET=<VOTRE_BUCKET_S3_MLFLOW>

# --- 4. Apache Kafka (KRaft Broker) & API de Scoring ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=raw-transactions
KAFKA_TOPIC_DLQ=fraud-dlq
KAFKA_GROUP_ID=fraud-scoring-group
API_SCORING_URL=http://localhost:8080/predict
HF_STREAM_URL=https://sdacelo-real-time-fraud-detection.hf.space/current-transactions

# --- 5. Sécurité RGPD & PCI-DSS (Hachage cryptographique SHA-256 salé) ---
SECRET_SALT=<VOTRE_SECRET_SALT_MIN_32_CHARS>

# --- 6. Alerting E-mail Temps Réel via smtplib (Gmail App Password ou Mailpit local) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=<votre.email@gmail.com>
SMTP_PASSWORD=<MOT_DE_PASSE_APPLICATION_GMAIL_16_CARACTERES>
ALERT_SENDER=<votre.email@gmail.com>
ALERT_RECIPIENT=<destinataire.alertes@gmail.com>
