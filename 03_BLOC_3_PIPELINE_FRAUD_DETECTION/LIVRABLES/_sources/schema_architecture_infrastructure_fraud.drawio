<mxfile host="app.diagrams.net"><diagram name="Architecture Pipeline Fraude Bloc 3"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1420" pageHeight="754"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n28" value="Détection de Fraude Bancaire — Architecture Hybride Déployée (Docker + Neon + AWS S3)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1340" height="30" as="geometry" /></mxCell><mxCell id="n2" value="1. Voie Temps Réel — Streaming Kafka, Pandera Gate &amp; Inférence FastAPI (Docker Local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="25" y="60" width="1370" height="326" as="geometry" /></mxCell><mxCell id="n3" value="2. Gouvernance MLOps, Cloud Managé (Neon + AWS S3) &amp; Orchestration Batch Airflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="25" y="452" width="1370" height="232" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;1. Source &amp;amp; Producer&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;API Hugging Face / CSV · JSON confluent-kafka (timeout 10s)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="104" width="215" height="96" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;2. Apache Kafka KRaft (:9092)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Topics raw-transactions &amp;amp; fraud-dlq · UI :8085&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="104" width="220" height="96" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;3. Consumer &amp;amp; Pandera&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Data Quality Gate (amt &amp;gt;= 0, coords GPS valides)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="104" width="225" height="96" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;4. FastAPI Scoring (:8080)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;POST /predict · 19.4 ms médiane / 28.9 ms p95&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="885" y="104" width="220" height="96" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;5. Alerting &amp;amp; Sink SQL&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;PAN **** 1234 · SHA-256 · Mailpit :8025 / Gmail TLS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1165" y="104" width="210" height="96" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;Quarantaine DLQ &amp;amp; Privacy-by-Design (.env)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Rejets amt &amp;lt; 0 / GPS -&amp;gt; topic fraud-dlq + Neon dead_letter_queue + rejected/ (_sanitize_payload_pii)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="525" y="260" width="375" height="104" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;6. MLflow (:5000) + AWS S3 (eu-west-3)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;555 719 tx · HistGradientBoosting @champion (0.9876 AUC / 91.61 % Recall) · Bucket S3 21 objets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="504" width="295" height="144" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;7. Data Lake Medallion Parquet&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;bronze/ -&amp;gt; rejected/ -&amp;gt; silver/ (DROP 7 PII + SHA-256 salé) -&amp;gt; gold/ + OpenLineage JSONL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="504" width="315" height="144" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b&gt;8. Apache Airflow 2.11 (:8088)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;DAG daily_fraud_audit_pipeline (06h00 UTC) : etl_bronze_to_silver -&amp;gt; gold_audit -&amp;gt; check_retrain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="735" y="504" width="295" height="144" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b&gt;9. Neon PostgreSQL SSL &amp;amp; FinOps&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Bases fraud_db &amp;amp; fraud_mlflow_db (eu-central-1) · Hybride ~0,10 €/mois (AWS Full-Cloud : ~30-60 €/mois)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="504" width="305" height="144" as="geometry" /></mxCell><mxCell id="n14" value="produce()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as=