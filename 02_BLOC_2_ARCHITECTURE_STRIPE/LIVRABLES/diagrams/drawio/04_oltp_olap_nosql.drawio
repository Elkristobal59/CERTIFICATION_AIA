<mxfile host="app.diagrams.net"><diagram name="OLTP vs OLAP vs NoSQL"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="640"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n18" value="Stripe — Articulation des 3 Paradigmes (OLTP 3NF / OLAP Étoile / NoSQL Document)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="30" as="geometry" /></mxCell><mxCell id="n2" value="1. OLTP — Aurora PostgreSQL (3NF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="65" width="345" height="425" as="geometry" /></mxCell><mxCell id="n3" value="2. OLAP — Amazon Redshift (Star Schema)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="415" y="65" width="345" height="425" as="geometry" /></mxCell><mxCell id="n4" value="3. NoSQL — DocumentDB (Mongo JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="795" y="65" width="350" height="425" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Transactions Financières ACID (&amp;lt; 10 ms)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Zéro perte ou double débit (Idempotence)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="58" y="115" width="298" height="78" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;12 Tables Normalisées (3NF)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Merchant, Customer, PaymentMethod, Transaction, FraudEvaluation, Refund, Dispute, Subscription, Payout, ProductCatalog, CountryRef, FXRate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="58" y="215" width="298" height="128" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Sécurité &amp;amp; Isolation&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Tokenization PCI-DSS Vault (Zéro PAN), HMAC-SHA256 sur emails, FK strictes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="58" y="366" width="298" height="96" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Analytique BI, Finance &amp;amp; Audits (&amp;lt; 2 s)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Agrégations multi-années sans impacter l&amp;#x27;OLTP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="438" y="115" width="298" height="78" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;12 Tables (7 Dims + 4 Faits + 1 Agrégat)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;FactTransactions, FactDailyMerchantRevenue, FactFraudAlerts, FactComplianceAudits, AggMonthlyProductPerformance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="438" y="215" width="298" height="128" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Optimisations Colonnaires&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Surrogate Keys, DISTKEY / SORTKEY, Vues Matérialisées &amp;amp; Opt-out CCPA natif&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="438" y="366" width="298" height="96" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;Événements Semi/Non-Structurés&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Schémas polymorphes haute vélocité&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="818" y="115" width="302" height="78" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b&gt;5 Collections DocumentDB&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;clickstream_events, device_fingerprints, webhook_delivery_logs, customer_feedback, ml_feature_vectors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="818" y="215" width="302" height="128" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b&gt;Cycle de Vie &amp;amp; Golden Bridge&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Index TTL 90 jours (RGPD), Index O(1) fingerprint, Clés jointure merchant_id / txn_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="818" y="366" width="302" height="96" as="geometry" /></mxCell><mxCell id="n14" value="&lt;b&gt;Intégration Polyglotte : Debezium CDC (WAL) + Change Streams DocumentDB  ---&amp;gt;  Kafka MSK  ---&amp;gt;  Flink / S3 Gold  ---&amp;gt;  Redshift &amp;amp; Feast Redis&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="550" width="1110" height="62" as="geometry" /></mxCell><mxCell id="n15" value="WAL CDC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.17;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n16" value="Micro-Batch &amp; Gold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n17" value="Change Streams" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.83;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>