<mxfile host="app.diagrams.net"><diagram name="Stratégie ML Hybride"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1260" pageHeight="665"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n24" value="Stripe — Architecture ML Hybride (Inférence &lt; 100 ms &amp; Boucle Batch MLOps)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1180" height="30" as="geometry" /></mxCell><mxCell id="n2" value="PARCOURS EN LIGNE (SYNCHRONE &lt; 100 ms) — Détection de Fraude Radar &amp; Adaptive Checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="25" y="62" width="1210" height="245" as="geometry" /></mxCell><mxCell id="n3" value="PARCOURS HORS-LIGNE (BATCH HEBDOMADAIRE) — Entraînement GPU, Validation &amp; Drift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="25" y="338" width="1210" height="272" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;1. API Checkout (&amp;lt; 15 ms)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Requête + Empreinte Device + Token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="116" width="195" height="80" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;2. Feature + k-NN (&amp;lt; 5 ms)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Feast Redis (Vélocité) + OpenSearch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="295" y="116" width="225" height="80" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;3. Scoring ONNX (&amp;lt; 20 ms)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;XGBoost Radar + Adaptive Checkout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="575" y="116" width="225" height="80" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;4. Décision &amp;amp; Routage (&amp;lt; 10 ms)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;ALLOW -&amp;gt; Aurora OLTP | CHALLENGE 3DS | BLOCK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="108" width="345" height="96" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Persistance Asynchrone DocumentDB&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Logs vecteurs 16D &amp;amp; Top Drivers SHAP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="575" y="224" width="300" height="64" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b&gt;1. Données S3 Gold &amp;amp; Offline&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Txns labellisées (Chargebacks J+60) + Retours NLP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="388" width="225" height="88" as="geometry" /></mxCell><mxCell id="n14" value="&lt;b&gt;2. Entraînement GPU SageMaker&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Radar Fraude, Bandit Checkout, Churn &amp;amp; Retries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="388" width="240" height="88" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b&gt;3. MLflow Registry &amp;amp; Canary&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Benchmark AUC / F1 &amp;amp; Validation 5% trafic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="625" y="388" width="240" height="88" as="geometry" /></mxCell><mxCell id="n16" value="&lt;b&gt;4. Monitoring Drift (Evidently AI)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#475569'&gt;Alerte PSI &amp;gt; 0.20 / Baisse F1 -&amp;gt; Réentraînement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="388" width="285" height="88" as="geometry" /></mxCell><mxCell id="n17" value="&lt;b&gt;Orchestration Apache Airflow (MWAA) : Réentraînement Hebdomadaire (Dimanche 02h)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="520" width="535" height="50" as="geometry" /></mxCell><mxCell id="n9" value="Contexte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n10" value="Features" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n11" value="Score [0-100]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;stro